<config>
  <item>
    <unit>＞</unit>
    <name>大于号</name>
    <ch_unit>大于号</ch_unit>
  </item>
  <item>
    <unit>＜</unit>
    <name>小于号</name>
    <ch_unit>小于号</ch_unit>
  </item>
  <item>
    <unit>≥</unit>
    <name>大于等于号 </name>
    <ch_unit>大于等于号 </ch_unit>
  </item>
  <item>
    <unit>≤</unit>
    <name>小于等于号</name>
    <ch_unit>小于等于号 </ch_unit>
  </item>
  <item>
    <unit>m</unit>
    <name>长度</name>
    <ch_unit>米</ch_unit>
  </item>
  <item>
    <unit>kg</unit>
    <name>重量</name>
    <ch_unit>千克（公斤）</ch_unit>
  </item>
  <item>
    <unit>s</unit>
    <name>时间</name>
    <ch_unit>秒</ch_unit>
  </item>
  <item>
    <unit>A</unit>
    <name>电流</name>
    <ch_unit>安[培]</ch_unit>
  </item>
  <item>
    <unit>K</unit>
    <name>热力学温度</name>
    <ch_unit>开[尔文]</ch_unit>
  </item>
  <item>
    <unit>mol</unit>
    <name>物质的量</name>
    <ch_unit>摩[文]</ch_unit>
  </item>
  <item>
    <unit>cd</unit>
    <name>发光强度</name>
    <ch_unit>坎[德拉]</ch_unit>
  </item>
  <item>
    <unit>Rad</unit>
    <name>[平面]角</name>
    <ch_unit>弧度</ch_unit>
  </item>
  <item>
    <unit>sr</unit>
    <name>立体角</name>
    <ch_unit>球面度</ch_unit>
  </item>
  <item>
    <unit>Hz</unit>
    <name>频率</name>
    <ch_unit>赫[兹]</ch_unit>
  </item>
  <item>
    <unit>N</unit>
    <name>力</name>
    <ch_unit>牛[顿]</ch_unit>
  </item>
  <item>
    <unit>Pa</unit>
    <name>压力，压强，应力</name>
    <ch_unit>帕[斯卡]</ch_unit>
  </item>
  <item>
    <unit>J</unit>
    <name>能[量]，功，热量</name>
    <ch_unit>焦[耳]</ch_unit>
  </item>
  <item>
    <unit>W</unit>
    <name>功率，辐[射能]，通量</name>
    <ch_unit>瓦[特]</ch_unit>
  </item>
  <item>
    <unit>C</unit>
    <name>电荷[量]</name>
    <ch_unit>库[仑]</ch_unit>
  </item>
  <item>
    <unit>V</unit>
    <name>电压，电动势，点位，（电势）</name>
    <ch_unit>伏[特]</ch_unit>
  </item>
  <item>
    <unit>F</unit>
    <name>电容</name>
    <ch_unit>法[拉]</ch_unit>
  </item>
  <item>
    <unit>Ω</unit>
    <name>电阻</name>
    <ch_unit>欧[姆]</ch_unit>
  </item>
  <item>
    <unit>S</unit>
    <name>电导</name>
    <ch_unit>西[门子]</ch_unit>
  </item>
  <item>
    <unit>Wb</unit>
    <name>磁通[量]</name>
    <ch_unit>韦伯</ch_unit>
  </item>
  <item>
    <unit>T</unit>
    <name>磁通[量]密度，磁感应强度</name>
    <ch_unit>特[斯拉]</ch_unit>
  </item>
  <item>
    <unit>H </unit>
    <name>电感</name>
    <ch_unit>亨[利]</ch_unit>
  </item>
  <item>
    <unit>℃</unit>
    <name>摄氏温度</name>
    <ch_unit>摄氏度</ch_unit>
  </item>
  <item>
    <unit>lm</unit>
    <name>光通量</name>
    <ch_unit>流[明]</ch_unit>
  </item>
  <item>
    <unit>lx</unit>
    <name>[光]照度 </name>
    <ch_unit>勒[克斯]</ch_unit>
  </item>

</config>