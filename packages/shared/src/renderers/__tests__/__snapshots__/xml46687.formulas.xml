  <front>
    <std-meta>
      <title-wrap xml:lang="zh">
        <full>测试标准</full>
      </title-wrap>
      <std-org-group>
        <std-org>
          <std-org-name>测试发布机构</std-org-name>
        </std-org>
      </std-org-group>
