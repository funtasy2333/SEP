// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderHtml — 全要素 fixture > print 变体快照 1`] = `
"<!DOCTYPE html>
<html lang="zh-CN" data-variant="print">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>标准化文件编辑系统</title>
<style>
:root {
  --ses-song: "Times New Roman", "SimSun", "宋体", "Songti SC", "STSong", serif;
  --ses-hei: "SimHei", "黑体", "Heiti SC", "STHeiti", sans-serif;
  --ses-fs-san: 16pt;     /* 三号：目次/前言/引言标题、正文首页文件名称 */
  --ses-fs-wu: 10.5pt;    /* 五号：章条标题、正文、图表编号题、术语、附录、参考文献标题、书眉 */
  --ses-fs-xiaowu: 9pt;   /* 小五：注/示例标识与内容、单位陈述、页码 */
  --ses-fs-liu: 7.5pt;    /* 六号：图中数字与文字 */
}

/* 镜像版心：top right bottom left（上 30mm=书眉下 5mm 起版心；下 20mm=页码距纸底；单数=右页 左25右20，双数=左页 左20右25） */
@page :right { size: A4; margin: 30mm 20mm 20mm 25mm; }
@page :left  { size: A4; margin: 30mm 25mm 20mm 20mm; }

/* 前置部分（目次/前言/引言）：罗马大写页码，书眉自目次页起 */
@page front:right { margin: 30mm 20mm 20mm 25mm;
    @top-right {
      content: "GB/T 12345—2026";
      font-family: var(--ses-hei);
      font-size: var(--ses-fs-wu);
      vertical-align: bottom;
      padding-bottom: 5mm;
    }
    @bottom-right {
      content: counter(page, upper-roman);
      font-family: var(--ses-song);
      font-size: var(--ses-fs-xiaowu);
      vertical-align: top;
    } }
@page front:left  { margin: 30mm 25mm 20mm 20mm;
    @top-left {
      content: "GB/T 12345—2026";
      font-family: var(--ses-hei);
      font-size: var(--ses-fs-wu);
      vertical-align: bottom;
      padding-bottom: 5mm;
    }
    @bottom-left {
      content: counter(page, upper-roman);
      font-family: var(--ses-song);
      font-size: var(--ses-fs-xiaowu);
      vertical-align: top;
    } }

/* 正文/附录/参考文献：阿拉伯页码（counter-reset 在 .ses-body-content 上从 1 起编） */
@page body:right { margin: 30mm 20mm 20mm 25mm;
    @top-right {
      content: "GB/T 12345—2026";
      font-family: var(--ses-hei);
      font-size: var(--ses-fs-wu);
      vertical-align: bottom;
      padding-bottom: 5mm;
    }
    @bottom-right {
      content: counter(page);
      font-family: var(--ses-song);
      font-size: var(--ses-fs-xiaowu);
      vertical-align: top;
    } }
@page body:left  { margin: 30mm 25mm 20mm 20mm;
    @top-left {
      content: "GB/T 12345—2026";
      font-family: var(--ses-hei);
      font-size: var(--ses-fs-wu);
      vertical-align: bottom;
      padding-bottom: 5mm;
    }
    @bottom-left {
      content: counter(page);
      font-family: var(--ses-song);
      font-size: var(--ses-fs-xiaowu);
      vertical-align: top;
    } }

/* 横排宽表（WP0 方案A 命名页）：页码居中、书眉居中 */
@page landscape {
  size: A4 landscape;
  margin: 25mm 28mm 20mm 28mm;
  @top-center {
    content: "GB/T 12345—2026";
    font-family: var(--ses-hei);
    font-size: var(--ses-fs-wu);
  }
  @bottom-center {
    content: counter(page);
    font-family: var(--ses-song);
    font-size: var(--ses-fs-xiaowu);
  }
  @footnote {
    margin-top: 3pt;
    padding-top: 3pt;
    font-family: var(--ses-song);
    font-size: var(--ses-fs-xiaowu);
    line-height: 1.25;
  }
  @footnote::before {
    content: "";
    display: block;
    width: 60.25mm;
    border-top: 0.5pt solid #000;
    margin: 0 0 3pt;
  }
}

/* 条文脚注区及短分隔线（10.4.4.2）：9 pt 宋体，竖排版心的四分之一。 */
@page {
  @footnote {
    margin-top: 3pt;
    padding-top: 3pt;
    font-family: var(--ses-song);
    font-size: var(--ses-fs-xiaowu);
    line-height: 1.25;
  }
  @footnote::before {
    content: "";
    display: block;
    width: 41.25mm;
    border-top: 0.5pt solid #000;
    margin: 0 0 3pt;
  }
}

/* 自动插入的空白页：计数但不印内容（WP4 微验证：必须按命名上下文 :blank 抑制） */
@page front:blank {
    @top-left{content:""} @top-center{content:""} @top-right{content:""}
    @bottom-left{content:""} @bottom-center{content:""} @bottom-right{content:""} }
@page body:blank {
    @top-left{content:""} @top-center{content:""} @top-right{content:""}
    @bottom-left{content:""} @bottom-center{content:""} @bottom-right{content:""} }
@page landscape:blank {
    @top-left{content:""} @top-center{content:""} @top-right{content:""}
    @bottom-left{content:""} @bottom-center{content:""} @bottom-right{content:""} }

/* A4 cover has no running header, footer or printed page number. */
@page cover {
  size: A4; margin: 0;
  @top-left { content: none; } @top-center { content: none; } @top-right { content: none; }
  @bottom-left { content: none; } @bottom-center { content: none; } @bottom-right { content: none; }
}
section.ses-cover { page: cover; break-after: page; }
.ses-cover-layout { position: relative; width: 210mm; height: 297mm; box-sizing: border-box; text-align: left; font-family: var(--ses-hei); }
.ses-cover-codes { position: absolute; left: 25mm; top: 9.17mm; font-size: 10.5pt; line-height: 1.5; }
.ses-cover-logo { position: absolute; right: 25mm; top: 14.5mm; font-family: var(--ses-song); font-size: 48pt; font-weight: bold; line-height: 1; white-space: nowrap; }
.ses-cover-logo img { vertical-align: baseline; }
.ses-cover-national .ses-cover-logo { top: 12.03mm; right: 30.99mm; }
.ses-cover-designation { position: absolute; left: 25mm; right: 15mm; top: 40.12mm; font-size: 24pt; text-align: justify; text-align-last: justify; line-height: 1.3; }
.ses-cover-national .ses-cover-designation { top: 37.54mm; font-family: var(--ses-song); font-size: 26pt; font-weight: bold; }
.ses-cover-guide .ses-cover-designation { font-size: 21pt; }
.ses-cover-number, .ses-cover-replaces { position: absolute; left: 25mm; right: 15mm; text-align: right; }
.ses-cover-number { top: 54.59mm; font-size: 14pt; }
.ses-cover-replaces { top: 64.41mm; font-size: 10.5pt; }
.ses-cover-rule { position: absolute; left: 25mm; right: 15mm; top: 69.16mm; border-top: 0.75pt solid black; }
.ses-cover-titles { position: absolute; left: 25mm; right: 15mm; top: 112.55mm; text-align: center; overflow-wrap: anywhere; }
.ses-cover-title { font-size: 26pt; line-height: 1.4; margin-bottom: 8mm; }
.ses-cover-english, .ses-cover-consistency, .ses-cover-stage { font-size: 14pt; line-height: 1.5; margin-bottom: 5mm; }
.ses-cover-patent { font-family: var(--ses-song); font-size: 10.5pt; line-height: 1.5; margin-top: 8mm; }
.ses-cover-dates { position: absolute; left: 25mm; right: 15mm; top: 249.6mm; display: flex; justify-content: space-between; padding-bottom: 4mm; border-bottom: 0.75pt solid black; font-size: 14pt; }
.ses-cover-issuer { position: absolute; left: 25mm; right: 15mm; top: 268.77mm; text-align: center; font-size: 14pt; }
.ses-cover-national .ses-cover-issuer { top: 261.57mm; }


/* 前置部分（目次→前言→引言）：罗马页码命名页 */
.ses-front-matter { page: front; counter-reset: page 1; }
/* 正文（含附录、参考文献）：阿拉伯页码，从 1 起编。
 * 电子出版 PDF 只要求正文页码从阿拉伯 1 起编，不要求正文落在物理单数页/右页，
 * 故用 break-before: page（普通另起页）而非 right，避免在前置部分后插入空白物理页。 */
.ses-body-content { page: body; counter-reset: page 1; break-before: page; }
/* 横排宽表容器：命名横排页 */
.ses-landscape { page: landscape; }

.ses-standard {
  font-family: var(--ses-song);
  font-size: var(--ses-fs-wu);
  line-height: 1.5;
  color: #000;
  text-align: justify;
}
.ses-standard p { margin: 0 0 4pt; orphans: 2; widows: 2; }

/* 条文段落首行缩进两个汉字 */
.ses-paragraph { text-indent: 2em; }

/* —— 前置标题（目次/前言/引言）：三号黑体居中；书眉下空 15mm、标题下空 12mm（图 E.8/E.9）—— */
.ses-front-heading {
  font-family: var(--ses-hei);
  font-size: var(--ses-fs-san);
  font-weight: bold;
  text-align: center;
  margin: 15mm 0 12mm;
  break-after: avoid;
}
.ses-foreword, .ses-introduction { break-before: page; }

/* —— 目次 —— */
.ses-toc-list { list-style: none; padding: 0; margin: 0; }
.ses-toc-item {
  display: flex;
  align-items: baseline;
  margin: 2pt 0;
}
.ses-toc-text::after {
  content: leader(dotted);
  flex: 1;
}
/* 目次内容一律五号宋体、不加粗（表 F.1 #15）；仅「目　次」标题为三号黑体（.ses-front-heading） */
/* 一级条空 1 字、二级条空 2 字起排（10.3.2、图 E.8） */
.ses-toc-l2 { padding-left: 1em; }
.ses-toc-l3 { padding-left: 2em; }
/* 页码占位：定宽（≈刚够两位数页码 2em）右对齐，缩小点线与页码间隙；
 * 占位 U+3000 与 WP5 注入的纯文本数字同处此定宽框、整框宽恒定 → 两遍分页不漂移（codex #28 评审采纳：保留预留宽度）。 */
.ses-toc-page { min-width: 2em; text-align: right; white-space: nowrap; }

/* —— 正文首页文件名称：三号黑体居中，书眉下空 15mm、名称下空 12mm —— */
.ses-doc-title-block { margin: 15mm 0 12mm; text-align: center; }
.ses-doc-title {
  font-family: var(--ses-hei);
  font-size: var(--ses-fs-san);
  font-weight: bold;
  margin: 0;
  line-height: 1.6;
}

/* 正文首页隐藏哨兵锚点：透明 + 零高度，仅供 pdftotext 提取以定位正文起始页，不占版式空间 */
.ses-body-anchor, .ses-front-anchor { display: block; height: 0; line-height: 0; color: transparent; font-size: 5pt; }

/* —— 章标题：五号黑体（与正文同字号）；上下各空一行（10.2.1）—— */
.ses-chapter-title {
  font-family: var(--ses-hei);
  font-size: var(--ses-fs-wu);
  font-weight: bold;
  margin: 1em 0;
  break-after: avoid;
}
.ses-chapter-title .ses-num { margin-right: 1em; }

/* —— 条标题：五号黑体；上下各空半行（10.2.1）—— */
.ses-clause-title {
  font-family: var(--ses-hei);
  font-size: var(--ses-fs-wu);
  font-weight: bold;
  margin: 0.5em 0;
  break-after: avoid;
}
.ses-clause-title .ses-num { margin-right: 1em; }
/* 无标题条（10.2.1）：编号顶格、后空一字接条文 —— */
.ses-clause-num-only { font-family: var(--ses-hei); font-weight: bold; margin-right: 1em; }
/* 无标题条首段：顶格起排（编号顶格），不缩进（区别于一般 .ses-paragraph 的首行缩进 2 字） */
.ses-clause-numbered-para { text-indent: 0; }

/* —— 术语条目（10.3.5、表 F.1 #22-24）三段式：
 *   ①编号独占一行、顶格、上下无空行（黑体五号）；
 *   ②术语 + 空一字 + 英文对应词 同一行、顶格（均黑体五号，英文行内、不斜体不灰）；
 *   ③定义/来源等各项另行、空两字起排（五号宋体，回行顶格＝首行缩进 2em）。—— */
.ses-term-entry { margin: 6pt 0; }
/* 编号行、术语名行都不得孤立在页尾：与其后紧邻的行同页（编号行 → 术语名行 → 定义首段）。
 * 只对这两行设 avoid，不给整个 .ses-term-entry 设 break-inside: avoid——长定义、注、示例会整体跳页，留下大片空白。 */
.ses-term-num-line { font-family: var(--ses-hei); font-weight: bold; margin: 0; break-after: avoid; page-break-after: avoid; }
.ses-term-head { font-family: var(--ses-hei); font-weight: bold; margin: 0; break-after: avoid; page-break-after: avoid; }
.ses-term-name-en { font-family: var(--ses-hei); font-weight: bold; }
.ses-term-def { text-indent: 2em; margin: 2pt 0; }
.ses-term-source { text-indent: 2em; margin: 2pt 0; }

/* —— 附录：编号/（规范性|资料性）/标题 三行，黑体五号居中，另起一页 —— */
.ses-appendix { break-before: page; }
.ses-appendix-label, .ses-appendix-kind, .ses-appendix-title {
  font-family: var(--ses-hei);
  font-size: var(--ses-fs-wu);
  font-weight: bold;
  text-align: center;
  margin: 0;
}
.ses-appendix-label { margin-top: 6pt; }
.ses-appendix-title { margin-bottom: 8pt; break-after: avoid; }

/* —— 参考文献：标题行黑体五号（非三号），另起一页 —— */
.ses-bibliography { break-before: page; }
.ses-bib-title {
  font-family: var(--ses-hei);
  font-size: var(--ses-fs-wu);
  font-weight: bold;
  text-align: center;
  margin: 0 0 8pt;
}
.ses-bib-entry { padding-left: 2em; text-indent: -2em; margin: 2pt 0; }

/* —— 列项（10.2.2）：标记由 CSS 计数器生成（保持渲染器无编号逻辑）；
 *   一级标记空 2 字起排（margin-left 2em）、文字/回行第 5 字位（padding-left 2em → 4em）；
 *   二级由嵌套再缩进 2 字（marker 4em / 文字 6em，容差从宽）。 —— */
.ses-list { margin: 4pt 0 4pt 2em; counter-reset: ses-li; }
.ses-list[data-level="2"], .ses-list-number, .ses-list-dot { margin-left: 4em; }
.ses-list .ses-list { margin-left: 0; }
.ses-list-item { position: relative; padding-left: 2em; }
.ses-list-item::before {
  position: absolute;
  left: 0;
  counter-increment: ses-li;
}
.ses-list-dash > .ses-list-item::before { content: "——"; counter-increment: none; font-family: "Times New Roman", serif; }
.ses-list-dot > .ses-list-item::before { content: "·"; counter-increment: none; }
.ses-list-number > .ses-list-item::before { content: counter(ses-li) "） "; }
.ses-list-alpha > .ses-list-item::before { content: counter(ses-li, lower-alpha) "） "; }
/* 小写罗马列项（GB/T 46687.2 5.7.2 roman-lower，WP8.M G7-c）：i） ii） iii）…，与字母/数字列项同为全角右括号；
 * 大写罗马 romanUpper 没有原文取值，仍按数字列项显示。 */
.ses-list-roman > .ses-list-item::before { content: counter(ses-li, lower-roman) "） "; }
.ses-list-romanUpper > .ses-list-item::before { content: counter(ses-li) "） "; }
/* 罗马标记宽度不定（vii）、viii）、xiii）…可超过 2 字）：不用绝对定位，改为左浮动 + 最小宽 2 字 + 左外边距 -2 字，
 * 标记较窄时与其他一级列项一样空两字起排、文字在第五字位，过宽时首行文字后移而不与标记重叠，回行仍对齐第五字位（10.2.2）。 */
.ses-list-roman > .ses-list-item::before { position: static; float: left; min-width: 2em; margin-left: -2em; }
.ses-list-boxed > .ses-list-item::before { content: counter(ses-li) " "; }
/* 二级数字列项保留编号；其他历史嵌套类型用间隔号，更深层由 DOCX 渲染器另行发出超层警告。 */
.ses-list .ses-list:not(.ses-list-number) > .ses-list-item::before { content: "·"; counter-increment: none; }

/* —— 表格：图表编号题 黑体五号居中；thead 跨页重复（含单位陈述行）—— */
.ses-table-block { margin: 8pt 0; break-inside: auto; }
.ses-table-caption {
  font-family: var(--ses-hei);
  font-size: var(--ses-fs-wu);
  font-weight: normal;
  text-align: center;
  margin: 8pt 0 3pt;
  break-after: avoid;
}
/* 表题英文（.ses-table-caption-en）print 不输出（仅 screen），故 print CSS 不含其样式（F8） */
/* 表中数字和文字：小五号宋体（表 F.1 #40 注 a；「以表形式编写的术语标准」用五号的例外本期未实现，列为范围差距） */
.ses-table-block table { border-collapse: collapse; width: 100%; font-size: var(--ses-fs-xiaowu); }
.ses-table-block thead { display: table-header-group; }
.ses-table-block tfoot { display: table-row-group; }
.ses-table-block th, .ses-table-block td {
  padding: 1.5mm 3mm;
  vertical-align: top;
}
.ses-table-block th { font-family: var(--ses-hei); font-weight: bold; text-align: center; }
.ses-table-block td { text-align: left; }
.ses-table-block td > .ses-paragraph, .ses-table-block th > .ses-paragraph { text-indent: 0; }
.ses-table-block tr { break-inside: avoid; }

.ses-table-block table { border: 1pt solid #000; }
.ses-table-block th, .ses-table-block td { border: 0.5pt solid #000; }
.ses-table-block thead th, .ses-table-block thead td, .ses-table-block th { border: 1pt solid #000; }
.ses-table-block .ses-table-notes td, .ses-table-block .ses-table-footnotes td { border: 1pt solid #000; }

.ses-table-footnote { font-size: var(--ses-fs-xiaowu); margin-left: 2em; text-indent: -1em; break-inside: avoid; }
.ses-table-footnote-marker { display: inline-block; width: calc(1em - 1pt); text-indent: 0; }
.ses-table-footnote-marker sup { font-size: 0.75em; vertical-align: super; }
.ses-table-footnote-ref { color: inherit; text-decoration: none; }

/* 原位条文脚注：只消费 IR/Resolver 给出的标记，Vivliostyle 负责页底浮动。 */
.ses-footnote {
  float: footnote;
  footnote-policy: line;
  footnote-display: block;
  margin-inline-start: 4em;
  text-indent: 0;
  font-family: var(--ses-song);
  font-size: var(--ses-fs-xiaowu);
  line-height: 1.25;
}
.ses-footnote::footnote-call {
  content: attr(data-label);
  vertical-align: super;
  font-size: 0.75em;
}
.ses-footnote::footnote-marker {
  content: none;
}
.ses-footnote-marker { float: left; width: 2em; margin-inline-start: -2em; line-height: 1.25; }
.ses-footnote-marker sup { font-size: 0.75em; vertical-align: super; }
/* 「关于单位的陈述」：IR 暂无独立字段（已知差距，出处 GB/T 1.1 9.8.3，与「表X（续）」一并进 V2），
 * 当前若作为表头行存在则随 thead 跨页重复（结构满足），其宋体小五/表右上方的字体定位待补字段后实现。 */

/* —— 图：图编号题 黑体五号居中 —— */
.ses-figure-block { margin: 8pt 0; text-align: center; break-inside: avoid; }
.ses-figure-image { max-width: 100%; }
.ses-figure-caption {
  font-family: var(--ses-hei);
  font-size: var(--ses-fs-wu);
  font-weight: bold;
  margin: 3pt 0 0;
  break-before: avoid;
}
/* 图题英文（.ses-figure-caption-en）print 不输出（仅 screen），故 print CSS 不含其样式（F8） */
/* 图中数字和文字：宋体六号（占位说明，实际作用于 SVG/位图内文本时由资源自带）*/
.ses-figure-image text { font-size: var(--ses-fs-liu); }
/* 行内图（M-8.3-02）：默认按原图尺寸自适应且不超出容器宽度；指定 size:S/M/L 时按 1/2/3 倍行高缩放 */
.ses-inline-image { display: inline-block; vertical-align: middle; max-width: 100%; height: auto; }
.ses-inline-image[data-size="S"] { height: 1.2em; }
.ses-inline-image[data-size="M"] { height: 2.4em; }
.ses-inline-image[data-size="L"] { height: 3.6em; }

/* —— 公式：编号右端对齐 + 点线引导；式中键值列表 —— */
/* 公式另行居中；编号右端对齐，公式与编号之间由点线连接（GB/T 1.1 10.4.3、9.9.2 示例）。
 * 三列网格：公式在中间列居中，编号区占第三列整列（公式右端到版心右缘）。
 * 编号区与目次条目同构：点线 span（::after leader）+ 编号 span，vivliostyle 的 leader 才会铺满；
 * 点线 span 占编号区剩余宽度（flex 项是该 span，不是 ::after），编号保持内容宽度靠右。 */
.ses-formula-block { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; margin: 10pt 0 4pt; }
.ses-formula { grid-column: 2; text-align: center; }
.ses-formula-tail {
  grid-column: 3;
  display: flex;
  align-items: baseline;
  padding-left: 0.5em;
}
.ses-formula-leader { flex: 1; }
.ses-formula-leader::after { content: leader(dotted); }
.ses-formula-num { font-family: var(--ses-song); white-space: nowrap; }
.ses-where { margin: 0 0 10pt 3em; }
.ses-where-intro { margin: 0 0 2pt; }
/* 符号列按本组最长符号定宽，后空 1 字接「——」（与 DOCX §5.10 的制表位一致），破折号各行对齐；释义回行与释义起点对齐 */
.ses-where-list { display: grid; grid-template-columns: min-content 1fr; column-gap: 1em; row-gap: 1pt; margin: 0; }
.ses-where-list dt { font-style: italic; white-space: nowrap; margin: 0; }
.ses-where-list dd { margin: 0; display: flex; }
.ses-where-dash { flex: none; }

/* —— 注 / 示例：标识黑体小五，内容宋体小五 —— */
.ses-note, .ses-example { font-size: var(--ses-fs-xiaowu); margin: 4pt 0 4pt 2em; }
.ses-note-marker, .ses-example-marker { font-family: var(--ses-hei); }
/* 多块注/示例（WP8.M G7-b，GB/T 1.1—2020 10.4.4.1、10.4.5）：
 * 注——标记在左、内容块在右（grid 两列），首段与「注：」同行，续段/列项回行与注的内容的文字位置左对齐，段不缩进；
 * 示例——「示例：」单独成行，其下逐块，文字类示例保留首行缩进（与 DOCX SesExText 一致）。 */
.ses-note-multi { display: grid; grid-template-columns: max-content 1fr; }
.ses-note-body > .ses-paragraph { text-indent: 0; margin: 0; }
.ses-note-body > .ses-list, .ses-example-multi > .ses-list { margin-top: 0; margin-bottom: 0; }
.ses-example-multi > .ses-example-marker { display: block; }
.ses-example-multi > .ses-paragraph { margin: 0; }

/* —— 交叉引用：print 变体为纯文本（无内部链接），此处仅保证字体一致 —— */
.ses-xref { color: inherit; text-decoration: none; }

/* —— 终结线（10.1.5）：文件最后一个要素之下，居中粗实线，长度为版心宽 1/4（版心 165mm → ≈41mm）；
 *   break-before: avoid 保证与末要素同页、不另起一面。 —— */
.ses-end-mark {
  width: 41mm;
  margin: 12pt auto 0;
  border-top: 1.5pt solid #000;
  break-before: avoid;
}
.ses-formula-inline .katex { font-size: 1em; }</style>
</head>
<body>
<article class="ses-standard" data-type="standard-doc" data-standard-no="GB/T 12345—2026" data-ics="35.240" data-ccs="L 70" data-title-cn="标准化文件编辑系统" data-title-en="Standardization document editing system" data-standard-type="gb">
<section class="ses-cover" data-type="cover" data-standard-type="gb"><div class="ses-cover-layout ses-cover-gb ses-cover-national">
<div class="ses-cover-codes">
<div>ICS 35.240</div>
<div>CCS L 70</div>
</div>
<div class="ses-cover-logo"><img src="data:image/png;base64," alt="GB 标志" style="width:40mm;height:20mm" /></div>
<div class="ses-cover-designation">中华人民共和国国家标准</div>
<div class="ses-cover-number">GB/T 12345—2026</div>
<div class="ses-cover-rule"></div><div class="ses-cover-titles">
<div class="ses-cover-title">标准化文件编辑系统</div>
<div class="ses-cover-english" lang="en">Standardization document editing system</div>
<div class="ses-cover-stage">（工作草案）</div>
</div>
<div class="ses-cover-dates"><span>2026-06-01 发布</span><span>2026-12-01 实施</span></div>
<div class="ses-cover-issuer"><img src="data:image/png;base64," alt="国家标准发布机构与发布" style="width:79.69mm;height:15.15mm" /></div>
</div></section>
<div class="ses-front-matter">
<span class="ses-front-anchor" aria-hidden="true">SESFRONTSTARTANCHOR</span>
<nav class="ses-toc" data-type="toc" id="front_toc">
<h1 class="ses-front-heading">目　次</h1>
<ol class="ses-toc-list">
<li class="ses-toc-item ses-toc-l1">
<span class="ses-toc-text">前言</span>
<span class="ses-toc-page" data-target="front_foreword">　</span>
</li>
<li class="ses-toc-item ses-toc-l1">
<span class="ses-toc-text">引言</span>
<span class="ses-toc-page" data-target="front_intro">　</span>
</li>
<li class="ses-toc-item ses-toc-l1">
<span class="ses-toc-text">1　范围</span>
<span class="ses-toc-page" data-target="sec_1">　</span>
</li>
<li class="ses-toc-item ses-toc-l1">
<span class="ses-toc-text">2　规范性引用文件</span>
<span class="ses-toc-page" data-target="sec_2">　</span>
</li>
<li class="ses-toc-item ses-toc-l1">
<span class="ses-toc-text">3　术语和定义</span>
<span class="ses-toc-page" data-target="sec_3">　</span>
</li>
<li class="ses-toc-item ses-toc-l1">
<span class="ses-toc-text">4　技术要求</span>
<span class="ses-toc-page" data-target="sec_4">　</span>
</li>
<li class="ses-toc-item ses-toc-l2">
<span class="ses-toc-text">4.1　总体要求</span>
<span class="ses-toc-page" data-target="sec_4.1">　</span>
</li>
<li class="ses-toc-item ses-toc-l2">
<span class="ses-toc-text">4.2　详细要求</span>
<span class="ses-toc-page" data-target="sec_4.2">　</span>
</li>
<li class="ses-toc-item ses-toc-l3">
<span class="ses-toc-text">4.2.2　性能</span>
<span class="ses-toc-page" data-target="sec_4.2.2">　</span>
</li>
<li class="ses-toc-item ses-toc-l1">
<span class="ses-toc-text">附录A　（规范性）附加技术内容</span>
<span class="ses-toc-page" data-target="sec_A">　</span>
</li>
<li class="ses-toc-item ses-toc-l1">
<span class="ses-toc-text">附录B　（资料性）资料性附录</span>
<span class="ses-toc-page" data-target="sec_B">　</span>
</li>
<li class="ses-toc-item ses-toc-l1">
<span class="ses-toc-text">参考文献</span>
<span class="ses-toc-page" data-target="sec_bibliography">　</span>
</li>
</ol>
</nav>
<section class="ses-foreword" data-type="foreword" id="front_foreword" role="doc-foreword">
<h1 class="ses-front-heading">前　言</h1>
<p class="ses-paragraph" data-type="paragraph" data-node-id="fw-p1">本文件按照GB/T 1.1—2020的规定起草。</p>
<div class="ses-note" data-type="note" data-node-id="fw-note" id="note_1"><span class="ses-note-marker">注：</span>前言中的注。</div>
</section>
<section class="ses-introduction" data-type="introduction" id="front_intro" role="doc-introduction">
<h1 class="ses-front-heading">引　言</h1>
<p class="ses-paragraph" data-type="paragraph" data-node-id="intro-p1">引言内容。</p>
</section>
</div>
<div class="ses-body-content">
<span class="ses-body-anchor" aria-hidden="true">SESBODYSTARTANCHOR</span>
<div class="ses-doc-title-block">
<h1 class="ses-doc-title">标准化文件编辑系统</h1>
</div>
<section class="ses-chapter" data-type="chapter" data-sec-type="scope" data-node-id="ch-scope" id="sec_1">
<h2 class="ses-chapter-title"><span class="ses-num">1</span>范围</h2>
<p class="ses-paragraph" data-type="paragraph" data-node-id="scope-p1">本文件规定了……</p>
</section>
<section class="ses-chapter" data-type="chapter" data-sec-type="norm-refs" data-node-id="ch-refs" id="sec_2">
<h2 class="ses-chapter-title"><span class="ses-num">2</span>规范性引用文件</h2>
<p class="ses-paragraph" data-type="paragraph" data-node-id="refs-p1">GB/T 1.1—2020</p>
</section>
<section class="ses-chapter" data-type="chapter" data-sec-type="terms" data-node-id="ch-terms" id="sec_3">
<h2 class="ses-chapter-title"><span class="ses-num">3</span>术语和定义</h2>
<p class="ses-paragraph" data-type="paragraph" data-node-id="terms-p0">下列术语和定义适用于本文件。</p>
<div class="ses-term-entry" data-type="term-entry" data-node-id="term-1" id="sec_3.1">
<p class="ses-term-num-line">3.1</p>
<p class="ses-term-head"><span class="ses-term-name">标准</span>　<span class="ses-term-name-en" lang="en">standard</span></p>
<p class="ses-term-def" data-node-id="term-1.def0">通过标准化活动制定的文件。</p>
<p class="ses-term-source">[来源：GB/T 20000.1—2014，5.3]</p>
<div class="ses-note" data-type="note" data-node-id="term-1-note" id="nte_3.1-1"><span class="ses-note-marker">注：</span>术语注。</div>
<div class="ses-example" data-type="example" data-node-id="term-1-ex" id="example_1"><span class="ses-example-marker">示例：</span>术语示例。</div>
</div>
<div class="ses-term-entry" data-type="term-entry" data-node-id="term-2" id="sec_3.2">
<p class="ses-term-num-line">3.2</p>
<p class="ses-term-head"><span class="ses-term-name">编号</span>　<span class="ses-term-name-en" lang="en">numbering</span></p>
<p class="ses-term-def" data-node-id="term-2.def0">为要素赋予序号。</p>
</div>
</section>
<section class="ses-chapter" data-type="chapter" data-sec-type="general" data-node-id="ch-4" id="sec_4">
<h2 class="ses-chapter-title"><span class="ses-num">4</span>技术要求</h2>
<section class="ses-clause ses-clause-l1" data-type="clause" data-level="1" data-titled="true" data-node-id="cl-41" id="sec_4.1">
<h3 class="ses-clause-title"><span class="ses-num">4.1</span>总体要求</h3>
<p class="ses-paragraph" data-type="paragraph" data-node-id="p-411">应满足<span class="ses-xref" data-ref-target="cl-42">4.2</span>与<span class="ses-xref" data-ref-target="tbl-1">表1</span>的要求。</p>
<div class="ses-list ses-list-alpha" data-type="list" data-list-type="alpha" data-node-id="list-1">
<div class="ses-list-item" data-node-id="li-1">
<span class="ses-list-item-text">第一项</span>
</div>
<div class="ses-list-item" data-node-id="li-2">
<span class="ses-list-item-text">第二项</span>
</div>
</div>
<div class="ses-note" data-type="note" data-node-id="n-41a" id="note_2"><span class="ses-note-marker">注1：</span>第一条注。</div>
<div class="ses-note" data-type="note" data-node-id="n-41b" id="note_3"><span class="ses-note-marker">注2：</span>第二条注。</div>
<div class="ses-example" data-type="example" data-node-id="ex-41a" id="example_2"><span class="ses-example-marker">示例1：</span>第一个示例。</div>
<div class="ses-example" data-type="example" data-node-id="ex-41b" id="example_3"><span class="ses-example-marker">示例2：</span>第二个示例。</div>
</section>
<section class="ses-clause ses-clause-l1" data-type="clause" data-level="1" data-titled="true" data-node-id="cl-42" id="sec_4.2">
<h3 class="ses-clause-title"><span class="ses-num">4.2</span>详细要求</h3>
<section class="ses-clause ses-clause-l2" data-type="clause" data-level="2" data-titled="false" data-node-id="cl-421" id="sec_4.2.1">
<p class="ses-clause-numbered-para" data-type="paragraph" data-node-id="p-4211"><span class="ses-clause-num-only">4.2.1</span>无题条内容，见<span class="ses-xref" data-ref-target="fig-1">图1</span>、<span class="ses-xref" data-ref-target="f-1">公式(1)</span>。</p>
</section>
<section class="ses-clause ses-clause-l2" data-type="clause" data-level="2" data-titled="true" data-node-id="cl-422" id="sec_4.2.2">
<h4 class="ses-clause-title"><span class="ses-num">4.2.2</span>性能</h4>
<div class="ses-table-block" data-type="table" data-orientation="portrait" data-node-id="tbl-1">
<div class="ses-table-caption">表1　性能指标</div>
<table id="tab_1">
<thead>
<tr>
<th scope="col">项目</th>
<th scope="col">指标</th>
</tr>
</thead>
<tbody>
<tr>
<th scope="row">精度</th>
<td>0.1</td>
</tr>
</tbody>
<tfoot>
<tr class="ses-table-notes"><td colspan="2"><div class="ses-note" data-type="note" data-node-id="tbl-1.note0" id="note_4"><span class="ses-note-marker">注：</span>表内的注。</div></td></tr>
</tfoot>
</table>
</div>
<figure class="ses-figure-block" data-type="figure" data-orientation="portrait" data-node-id="fig-1" id="fig_1">
<img class="ses-figure-image" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAHgAAAA8CAIAAAAiz+n/AAAAa0lEQVR42u3QQQ0AAAgEoOsfzwRmMIEtnA82EpDq4UAUiBaNaNGiLYgWjWjRoi2IFo1o0aIRLRrRokUjWjSiRYtGtGhEixaNaNGIFi0a0aIRLRrRokUjWjSiRYtGtGhEixaNaNGiES0a0b8s0ipI1zvfEP8AAAAASUVORK5CYII=" alt="系统架构图" />
<figcaption class="ses-figure-caption">图1　系统架构图</figcaption>
</figure>
<div class="ses-formula-block" data-type="formula" data-node-id="f-1" id="formula_1">
<span class="ses-formula" data-latex="E = mc^2"></span>
<span class="ses-formula-tail"><span class="ses-formula-leader"></span><span class="ses-formula-num">（1）</span></span>
</div>
<div class="ses-where">
<p class="ses-where-intro">式中：</p>
<dl class="ses-where-list">
<dt data-node-id="f-1.w0">E</dt><dd><span class="ses-where-dash">——</span><span class="ses-where-text">能量，单位为焦耳（J）</span></dd>
<dt data-node-id="f-1.w1">m</dt><dd><span class="ses-where-dash">——</span><span class="ses-where-text">质量</span></dd>
<dt data-node-id="f-1.w2">c</dt><dd><span class="ses-where-dash">——</span><span class="ses-where-text">光速。</span></dd>
</dl>
</div>
<p class="ses-paragraph" data-type="paragraph" data-node-id="p-4221">引用文献<span class="ses-xref" data-ref-target="bib-2">[1]</span>。</p>
</section>
</section>
</section>
<section class="ses-appendix" data-type="appendix" data-normative="true" data-node-id="app-a" id="sec_A" role="doc-appendix">
<div class="ses-appendix-label">附录A</div>
<div class="ses-appendix-kind">（规范性）</div>
<h2 class="ses-appendix-title">附加技术内容</h2>
<section class="ses-clause ses-clause-l1" data-type="clause" data-level="1" data-titled="true" data-node-id="cl-a1" id="sec_A.1">
<h3 class="ses-clause-title"><span class="ses-num">A.1</span>附录条</h3>
<p class="ses-paragraph" data-type="paragraph" data-node-id="p-a11">附录正文。</p>
</section>
<section class="ses-clause ses-clause-l1" data-type="clause" data-level="1" data-titled="true" data-node-id="cl-a2" id="sec_A.2">
<h3 class="ses-clause-title"><span class="ses-num">A.2</span>附录图表</h3>
<figure class="ses-figure-block" data-type="figure" data-orientation="portrait" data-node-id="fig-a1" id="fig_A.1">
<img class="ses-figure-image" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAHgAAAA8CAIAAAAiz+n/AAAAa0lEQVR42u3QMQ0AAAgDsPkXyYECJOCCcDSpgqanOBAFokUjWrRoC6JFI1q0aAuiRSNatGhEi0a0aNGIFo1o0aIRLRrRokUjWjSiRYtGtGhEixaNaNGIFi0a0aIRLVo0okUjWrRoRItG9C8L4K2aZtr7WR4AAAAASUVORK5CYII=" alt="附录图" />
<figcaption class="ses-figure-caption">图A.1　附录图</figcaption>
</figure>
<div class="ses-table-block" data-type="table" data-orientation="portrait" data-node-id="tbl-a1">
<div class="ses-table-caption">表A.1　附录表</div>
<table id="tab_A.1">
<thead>
<tr>
<th scope="col">列</th>
</tr>
</thead>
<tbody>
<tr>
<td>值</td>
</tr>
</tbody>
</table>
</div>
<div class="ses-formula-block" data-type="formula" data-node-id="f-a1" id="formula_A.1">
<span class="ses-formula" data-latex="x = y"></span>
<span class="ses-formula-tail"><span class="ses-formula-leader"></span><span class="ses-formula-num">（A.1）</span></span>
</div>
</section>
</section>
<section class="ses-appendix" data-type="appendix" data-normative="false" data-node-id="app-b" id="sec_B" role="doc-appendix">
<div class="ses-appendix-label">附录B</div>
<div class="ses-appendix-kind">（资料性）</div>
<h2 class="ses-appendix-title">资料性附录</h2>
<p class="ses-paragraph" data-type="paragraph" data-node-id="p-b1">资料性内容。</p>
</section>
<section class="ses-bibliography" data-type="bibliography" id="sec_bibliography" role="doc-bibliography">
<h2 class="ses-bib-title">参考文献</h2>
<div class="ses-bib-entry" data-node-id="bib-2" id="biblref_1">[1]　ISO/IEC Directives, Part 2</div>
<div class="ses-bib-entry" data-node-id="bib-1" id="biblref_2">[2]　GB/T 20000.1—2014 标准化工作指南</div>
</section>
<div class="ses-end-mark" role="presentation"></div>
</div>
</article>
</body>
</html>"
`;

exports[`renderHtml — 全要素 fixture > screen 变体快照 1`] = `
"<!DOCTYPE html>
<html lang="zh-CN" data-variant="screen">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>标准化文件编辑系统</title>
<style>
    body { margin: 0; background: #f5f5f5; }
    .ses-standard {
      font-family: "Times New Roman", "SimSun", "宋体", "STSong", serif;
      font-size: 14px; line-height: 1.8; color: #000;
      max-width: 210mm; margin: 0 auto; padding: 20mm; background: #fff;
    }
    .ses-front-heading { font-family: "SimHei", "黑体", sans-serif; font-weight: bold; font-size: 20px; text-align: center; margin: 24px 0 16px; }
    .ses-doc-title-block { text-align: center; margin: 24px 0; }
    .ses-doc-title { font-family: "SimHei", "黑体", sans-serif; font-size: 22px; margin: 4px 0; }
    .ses-chapter-title { font-family: "SimHei", "黑体", sans-serif; font-size: 17px; margin: 20px 0 10px; }
    .ses-clause-title { font-family: "SimHei", "黑体", sans-serif; font-size: 15px; margin: 12px 0 6px; }
    .ses-chapter-title .ses-num, .ses-clause-title .ses-num, .ses-clause-num-only { margin-right: 0.6em; }
    .ses-paragraph { text-indent: 2em; margin: 6px 0; }
    .ses-term-entry { margin: 10px 0; }
    .ses-term-num-line { font-family: "SimHei", "黑体", sans-serif; font-weight: bold; margin: 0; }
    .ses-term-head { font-family: "SimHei", "黑体", sans-serif; margin: 0; }
    .ses-term-name-en { font-family: "SimHei", "黑体", sans-serif; }
    .ses-term-def, .ses-term-source { text-indent: 2em; margin: 2px 0; }
    .ses-toc-list { list-style: none; padding: 0; }
    .ses-toc-item { margin: 4px 0; }
    .ses-toc-l2 { padding-left: 2em; }
    .ses-toc-l3 { padding-left: 4em; }
    .ses-toc-text { color: #0066cc; text-decoration: none; }
    .ses-list { padding-left: 2em; margin: 8px 0; counter-reset: ses-li; }
    .ses-list[data-level="2"], .ses-list-number, .ses-list-dot { padding-left: 4em; }
    .ses-list .ses-list { padding-left: 0; }
    .ses-list-item { position: relative; padding-left: 2em; margin: 2px 0; }
    .ses-list-item::before { position: absolute; left: 0; counter-increment: ses-li; }
    .ses-list-dash > .ses-list-item::before { content: "——"; counter-increment: none; }
    .ses-list-dot > .ses-list-item::before { content: "·"; counter-increment: none; }
    .ses-list-number > .ses-list-item::before { content: counter(ses-li) "） "; }
    .ses-list-alpha > .ses-list-item::before { content: counter(ses-li, lower-alpha) "） "; }
    .ses-list-roman > .ses-list-item::before { content: counter(ses-li, lower-roman) "） "; }
    .ses-list-romanUpper > .ses-list-item::before { content: counter(ses-li) "） "; }
    .ses-list-roman > .ses-list-item::before { position: static; float: left; min-width: 2em; margin-left: -2em; }
    .ses-list .ses-list:not(.ses-list-number) > .ses-list-item::before { content: "·"; counter-increment: none; }
    .ses-table-block { margin: 16px 0; }
    .ses-table-caption { font-family: "SimHei", "黑体", sans-serif; font-weight: normal; text-align: center; margin: 8px 0 4px; }
    .ses-table-caption-en { text-align: center; font-style: italic; color: #555; }
    .ses-table-block table { border-collapse: collapse; width: 100%; }
    .ses-table-block th, .ses-table-block td { padding: 6px 8px; }

.ses-table-block table { border: 1pt solid #000; }
.ses-table-block th, .ses-table-block td { border: 0.5pt solid #000; }
.ses-table-block thead th, .ses-table-block thead td, .ses-table-block th { border: 1pt solid #000; }
.ses-table-block .ses-table-notes td, .ses-table-block .ses-table-footnotes td { border: 1pt solid #000; }

    .ses-table-block th { background: #f5f5f5; }
    .ses-table-block td > .ses-paragraph, .ses-table-block th > .ses-paragraph { text-indent: 0; }
    .ses-figure-block { text-align: center; margin: 16px 0; }
    .ses-figure-image { max-width: 100%; }
    .ses-inline-image { display: inline-block; vertical-align: middle; max-width: 100%; height: auto; }
    .ses-inline-image[data-size="S"] { height: 1.2em; }
    .ses-inline-image[data-size="M"] { height: 2.4em; }
    .ses-inline-image[data-size="L"] { height: 3.6em; }
    .ses-figure-caption { font-family: "SimHei", "黑体", sans-serif; font-weight: bold; margin-top: 8px; }
    .ses-figure-caption-en { font-style: italic; color: #555; }
    .ses-formula-block { display: flex; align-items: center; margin: 16px 0 6px; }
    .ses-formula { flex: 1; text-align: center; }
    .ses-formula-tail { width: 5em; text-align: right; }
    .ses-formula-leader { display: none; }
    .ses-where { margin: 0 0 12px 3em; }
    .ses-where-list { display: grid; grid-template-columns: min-content 1fr; column-gap: 1em; }
    .ses-where-list dt { font-style: italic; }
    .ses-where-list dd { margin: 0; display: flex; }
    .ses-where-dash { flex: none; }
    .ses-note, .ses-example { padding-left: 2em; font-size: 13px; color: #333; margin: 8px 0; }
    .ses-note-marker, .ses-example-marker { font-family: "SimHei", "黑体", sans-serif; }
    .ses-note-multi { display: grid; grid-template-columns: max-content 1fr; }
    .ses-note-body > .ses-paragraph { text-indent: 0; margin: 0; }
    .ses-note-body > .ses-list, .ses-example-multi > .ses-list { margin-top: 0; margin-bottom: 0; }
    .ses-example-multi > .ses-example-marker { display: block; }
    .ses-example-multi > .ses-paragraph { margin: 0; }
    .ses-footnote { font-size: 0.85em; }
    .ses-footnote::before { content: attr(data-label); vertical-align: super; font-size: 0.75em; margin-right: 0.35em; }
    .ses-table-footnote { font-size: 13px; margin-left: calc(3em - 8px); text-indent: -1em; }
    .ses-table-footnote-marker { display: inline-block; width: 1em; text-indent: 0; }
    .ses-table-footnote-ref { color: inherit; text-decoration: none; }
    .ses-appendix-label, .ses-appendix-kind, .ses-appendix-title { font-family: "SimHei", "黑体", sans-serif; text-align: center; margin: 4px 0; }
    .ses-appendix-title { font-size: 17px; }
    .ses-bib-title { font-family: "SimHei", "黑体", sans-serif; text-align: center; font-size: 17px; margin: 20px 0 12px; }
    .ses-bib-entry { padding-left: 2em; text-indent: -2em; margin: 4px 0; }
    .ses-xref { color: #0066cc; }
.ses-formula-inline .katex { font-size: 1em; }</style>
</head>
