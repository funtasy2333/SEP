{
  "name": "ses",
  "version": "0.1.0",
  "private": true,
  "description": "Standards Editor System - 标准化文件编辑系统",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:client": "pnpm --filter @ses/client dev",
    "dev:server": "pnpm --filter @ses/server dev",
    "build": "pnpm -r run build",
    "build:client": "pnpm --filter @ses/client build",
    "build:server": "pnpm --filter @ses/server build",
    "setup": "node scripts/setup-office.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "better-sqlite3",
      "unrs-resolver"
    ]
  }
}
